{
  "name": "@mosire/dsh-inbox-mosire",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "InboxMosire v2 multi-binding wake adapter for DeepSeek Harness: bounded summary wakes, per-binding SSE/cursor/wake isolation, advisory occupancy, and a WebUI inbox-count dock panel.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./tools": "./tools.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test",
    "test:live": "node --test test/real-backend.test.mjs",
    "acceptance:acp": "node scripts/acceptance-acp.mjs"
  },
  "license": "MIT"
}
